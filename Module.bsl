Функция Инструмент_GetMetadataTree(Аргументы)
        
        Дерево = Новый Соответствие;
        
        // Справочники
        Список = Новый Массив;
        Для Каждого МД Из Метаданные.Справочники Цикл
                Эл = Новый Соответствие;
                Эл.Вставить("name", МД.Имя);
                Эл.Вставить("synonym", МД.Синоним);
                Эл.Вставить("full_name", "Справочник." + МД.Имя);
                Список.Добавить(Эл);
        КонецЦикла;
        Дерево.Вставить("Справочники", Список);
        
        // Документы
        Список = Новый Массив;
        Для Каждого МД Из Метаданные.Документы Цикл

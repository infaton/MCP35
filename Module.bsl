// --- save_report_variant ----------------------------------------------------
 
Функция Инструмент_SaveReportVariant(Аргументы)
 
                  ИмяОтчета = Аргументы["report_name"];
                  КлючВарианта = Аргументы["variant_key"];
                  Представление = Аргументы["variant_presentation"];
                  НастройкиXML = Аргументы["settings_xml"];
                  КлючИсточника = Аргументы["source_variant_key"];
                  ИмяПользователя = Аргументы["user_name"];
 
                  Если НЕ ЗначениеЗаполнено(Представление) Тогда
                                    Представление = КлючВарианта;
                  КонецЕсли;
 
                  МДОтчета = Метаданные.Отчеты.Найти(ИмяОтчета);
                  Если МДОтчета = Неопределено Тогда
                                    Возврат "Ошибка: отчёт '" + ИмяОтчета + "' не найден в конфигурации. Используй list_reports для списка.";
                  КонецЕсли;
                  КлючОбъекта = "Отчет." + ИмяОтчета;
 
                  // --- Определяем настройки варианта: XML → копия → по умолчанию ---------
                  Настройки = Неопределено;
                  Источник = "";
 
                  Если ЗначениеЗаполнено(НастройкиXML) Тогда
                                    Попытка
                                                     Чтение = Новый ЧтениеXML;
                                                     Чтение.УстановитьСтроку(НастройкиXML);
                                                     Настройки = СериализаторXDTO.ПрочитатьXML(Чтение, Тип("НастройкиКомпоновкиДанных"));
                                                     Чтение.Закрыть();
                                                     Источник = "settings_xml";
                                    Исключение
                                                     Возврат "Ошибка разбора settings_xml: " + ОписаниеОшибки();
                                    КонецПопытки;
                  ИначеЕсли ЗначениеЗаполнено(КлючИсточника) Тогда
                                    Настройки = ХранилищеВариантовОтчетов.Загрузить(КлючОбъекта, КлючИсточника, , ИмяПользователя);
                                    Если Настройки = Неопределено Тогда
                                                     // пробуем общий вариант (без пользователя)
                                                     Настройки = ХранилищеВариантовОтчетов.Загрузить(КлючОбъекта, КлючИсточника);
                                    КонецЕсли;
                                    Если Настройки = Неопределено Тогда
                                                     Возврат "Ошибка: исходный вариант '" + КлючИсточника + "' отчёта " + ИмяОтчета + " не найден.";
                                    КонецЕсли;
                                    Источник = "копия варианта " + КлючИсточника;
                  Иначе
                                    Если МДОтчета.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
                                                     Возврат "Ошибка: у отчёта '" + ИмяОтчета + "' нет основной схемы СКД — передай settings_xml или source_variant_key.";
                                    КонецЕсли;
                                    Схема = Отчеты[ИмяОтчета].ПолучитьМакет(МДОтчета.ОсновнаяСхемаКомпоновкиДанных.Имя);
                                    Настройки = Схема.НастройкиПоУмолчанию;
                                    Источник = "настройки по умолчанию схемы СКД";
                  КонецЕсли;
 
                  // --- Сохраняем ----------------------------------------------------------
                  Описание = Новый ОписаниеНастроек;
                  Описание.Представление = Представление;
                  Попытка
                                    Если ЗначениеЗаполнено(ИмяПользователя) Тогда
                                                     ХранилищеВариантовОтчетов.Сохранить(КлючОбъекта, КлючВарианта, Настройки, Описание, ИмяПользователя);
                                    Иначе
                                                     ХранилищеВариантовОтчетов.Сохранить(КлючОбъекта, КлючВарианта, Настройки, Описание);
                                    КонецЕсли;
                  Исключение
                                    Возврат "Ошибка сохранения варианта: " + ОписаниеОшибки();
                  КонецПопытки;
 
                  Результат = Новый Соответствие;
                  Результат.Вставить("success", Истина);
                  Результат.Вставить("report", КлючОбъекта);
                  Результат.Вставить("variant_key", КлючВарианта);
                  Результат.Вставить("presentation", Представление);
                  Результат.Вставить("settings_source", Источник);
                  Результат.Вставить("scope", ?(ЗначениеЗаполнено(ИмяПользователя), "пользователь " + ИмяПользователя, "общий (все пользователи)"));
                  Результат.Вставить("note", "Если конфигурация использует БСП-справочник ВариантыОтчетов, вариант появится после регламентного обновления вариантов или через Все функции → Стандартные → Варианты отчётов.");
                  Возврат ОбъектВJSON(Результат);
 
КонецФункции
 
// --- set_user_setting --------------------------------------------------------
 
Функция Инструмент_SetUserSetting(Аргументы)
 
                  КлючОбъекта = Аргументы["object_key"];
                  КлючНастроек = Аргументы["settings_key"];
                  ЗначениеJSON = Аргументы["value_json"];
                  ИмяПользователя = Аргументы["user_name"];
                  Хранилище = Аргументы["storage"];
 
                  // Разбор значения из JSON (строка/число/булево/объект)
                  Попытка
                                    ЧтениеJSON = Новый ЧтениеJSON;
                                    ЧтениеJSON.УстановитьСтроку(ЗначениеJSON);
                                    Значение = ПрочитатьJSON(ЧтениеJSON, Ложь);
                                    ЧтениеJSON.Закрыть();
                  Исключение
                                    // не JSON — используем как строку
                                    Значение = ЗначениеJSON;
                  КонецПопытки;
 
                  Попытка
                                    Если Хранилище = "system" Тогда
                                                     Если ЗначениеЗаполнено(ИмяПользователя) Тогда
                                                                       ХранилищеСистемныхНастроек.Сохранить(КлючОбъекта, КлючНастроек, Значение, , ИмяПользователя);
                                                     Иначе
                                                                       ХранилищеСистемныхНастроек.Сохранить(КлючОбъекта, КлючНастроек, Значение);
                                                     КонецЕсли;
                                    Иначе
                                                     Если ЗначениеЗаполнено(ИмяПользователя) Тогда
                                                                       ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, Значение, , ИмяПользователя);
                                                     Иначе
                                                                       ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, Значение);
                                                     КонецЕсли;
                                    КонецЕсли;
                  Исключение
                                    Возврат "Ошибка записи настройки: " + ОписаниеОшибки();
                  КонецПопытки;
 
                  Результат = Новый Соответствие;
                  Результат.Вставить("success", Истина);
                  Результат.Вставить("object_key", КлючОбъекта);
                  Результат.Вставить("settings_key", КлючНастроек);
                  Результат.Вставить("storage", ?(Хранилище = "system", "ХранилищеСистемныхНастроек", "ХранилищеОбщихНастроек"));
                  Результат.Вставить("user", ?(ЗначениеЗаполнено(ИмяПользователя), ИмяПользователя, "текущий пользователь сервиса"));
                  Возврат ОбъектВJSON(Результат);
 
КонецФункции
 
// --- set_constant ------------------------------------------------------------
 
Функция Инструмент_SetConstant(Аргументы)
 
                  ИмяКонстанты = Аргументы["constant_name"];
                  НовоеЗначениеСтрока = Аргументы["value"];
 
                  МДКонстанты = Метаданные.Константы.Найти(ИмяКонстанты);
                  Если МДКонстанты = Неопределено Тогда
                                    Возврат "Ошибка: константа '" + ИмяКонстанты + "' не найдена в конфигурации.";
                  КонецЕсли;
 
                  СтароеЗначение = Константы[ИмяКонстанты].Получить();
 
                  // Приведение к типу константы
                  НовоеЗначение = ПривестиЗначениеКТипу_В44(НовоеЗначениеСтрока, МДКонстанты.Тип);
                  Если НовоеЗначение = Неопределено И ВРег(Строка(НовоеЗначениеСтрока)) <> "НЕОПРЕДЕЛЕНО" Тогда
                                    Возврат "Ошибка: не удалось привести значение '" + Строка(НовоеЗначениеСтрока)
                                                     + "' к типу константы " + Строка(МДКонстанты.Тип) + ".";
                  КонецЕсли;
 
                  Попытка
                                    Константы[ИмяКонстанты].Установить(НовоеЗначение);
                  Исключение
                                    Возврат "Ошибка установки константы: " + ОписаниеОшибки();
                  КонецПопытки;
 
                  Результат = Новый Соответствие;
                  Результат.Вставить("success", Истина);
                  Результат.Вставить("constant", ИмяКонстанты);
                  Результат.Вставить("old_value", Строка(СтароеЗначение));
                  Результат.Вставить("new_value", Строка(НовоеЗначение));
                  Возврат ОбъектВJSON(Результат);
 
КонецФункции
 
// --- set_functional_option ---------------------------------------------------
 
Функция Инструмент_SetFunctionalOption(Аргументы)
 
                  ИмяОпции = Аргументы["option_name"];
                  ЗначениеСтрока = Аргументы["value"];
 
                  МДОпции = Метаданные.ФункциональныеОпции.Найти(ИмяОпции);
                  Если МДОпции = Неопределено Тогда
                                    // поиск по синониму
                                    Для Каждого МД Из Метаданные.ФункциональныеОпции Цикл
                                                     Если МД.Синоним = ИмяОпции Тогда
                                                                       МДОпции = МД;
                                                                       Прервать;
                                                     КонецЕсли;
                                    КонецЦикла;
                  КонецЕсли;
                  Если МДОпции = Неопределено Тогда
                                    Возврат "Ошибка: функциональная опция '" + ИмяОпции + "' не найдена. Используй get_functional_options для списка.";
                  КонецЕсли;
 
                  Хранилище = МДОпции.Хранилище;
                  Если Хранилище = Неопределено Тогда
                                    Возврат "Ошибка: у опции '" + ИмяОпции + "' не задано хранилище — программная установка невозможна.";
                  КонецЕсли;
                  Если НЕ Метаданные.Константы.Содержит(Хранилище) Тогда
                                    Возврат "Ошибка: опция '" + ИмяОпции + "' хранится не в константе (" + Хранилище.ПолноеИмя()
                                                     + ") — вероятно, это параметризованная ФО. Установи значение через update_object по объекту-хранилищу.";
                  КонецЕсли;
 
                  НовоеЗначение = ВРег(Строка(ЗначениеСтрока)) = "TRUE" Или ВРег(Строка(ЗначениеСтрока)) = "ИСТИНА" Или Строка(ЗначениеСтрока) = "1";
                  СтароеЗначение = Константы[Хранилище.Имя].Получить();
 
                  Попытка
                                    Константы[Хранилище.Имя].Установить(НовоеЗначение);
                  Исключение
                                    Возврат "Ошибка установки функциональной опции: " + ОписаниеОшибки();
                  КонецПопытки;
 
                  Результат = Новый Соответствие;
                  Результат.Вставить("success", Истина);
                  Результат.Вставить("option", МДОпции.Имя);
                  Результат.Вставить("storage_constant", Хранилище.Имя);
                  Результат.Вставить("old_value", СтароеЗначение);
                  Результат.Вставить("new_value", НовоеЗначение);
                  Результат.Вставить("note", "Изменение видимости в интерфейсе пользователи увидят после обновления интерфейса (ОбновитьИнтерфейс) или перезахода в программу.");
                  Возврат ОбъектВJSON(Результат);
 
КонецФункции
 
// --- assign_role_to_user -----------------------------------------------------
 
Функция Инструмент_AssignRoleToUser(Аргументы)
 
                  ИмяПользователя = Аргументы["user_name"];
                  ИмяРоли = Аргументы["role_name"];
                  Действие = Аргументы["action"];
                  Если НЕ ЗначениеЗаполнено(Действие) Тогда
                                    Действие = "add";
                  КонецЕсли;
 
                  Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
                  Если Пользователь = Неопределено Тогда
                                    Возврат "Ошибка: пользователь ИБ '" + ИмяПользователя + "' не найден. Используй get_active_users или список пользователей.";
                  КонецЕсли;
 
                  МДРоли = Метаданные.Роли.Найти(ИмяРоли);
                  Если МДРоли = Неопределено Тогда
                                    Для Каждого МД Из Метаданные.Роли Цикл
                                                     Если МД.Синоним = ИмяРоли Тогда
                                                                       МДРоли = МД;
                                                                       Прервать;
                                                     КонецЕсли;
                                    КонецЦикла;
                  КонецЕсли;
                  Если МДРоли = Неопределено Тогда
                                    Возврат "Ошибка: роль '" + ИмяРоли + "' не найдена в конфигурации.";
                  КонецЕсли;
 
                  Была = Пользователь.Роли.Содержит(МДРоли);
                  Попытка
                                    Если Действие = "remove" Тогда
                                                     Если Была Тогда
                                                                       Пользователь.Роли.Удалить(МДРоли);
                                                     КонецЕсли;
                                    Иначе
                                                     Если НЕ Была Тогда
                                                                       Пользователь.Роли.Добавить(МДРоли);
                                                     КонецЕсли;
                                    КонецЕсли;
                                    Пользователь.Записать();
                  Исключение
                                    Возврат "Ошибка изменения ролей пользователя: " + ОписаниеОшибки();
                  КонецПопытки;
 
                  Результат = Новый Соответствие;
                  Результат.Вставить("success", Истина);
                  Результат.Вставить("user", ИмяПользователя);
                  Результат.Вставить("role", МДРоли.Имя);
                  Результат.Вставить("action", Действие);
                  Результат.Вставить("had_role_before", Была);
                  Результат.Вставить("warning", "В конфигурациях с БСП (ERP/УТ/КА/БП) права назначаются группами доступа: прямое изменение ролей ИБ-пользователя может быть перезаписано при пересчёте прав. Для стойкого назначения добавь пользователя в группу доступа с профилем, содержащим роль.");
                  Возврат ОбъектВJSON(Результат);
 
КонецФункции
 
// --- load_extension ------------------------------------------------------------
 
Функция Инструмент_LoadExtension(Аргументы)
 
                  ДанныеBase64 = Аргументы["data_base64"];
                  БезопасныйРежимСтрока = Аргументы["safe_mode"];
                  БезопасныйРежим = Истина;
                  Если ЗначениеЗаполнено(БезопасныйРежимСтрока) Тогда
                                    БезопасныйРежим = НЕ (ВРег(Строка(БезопасныйРежимСтрока)) = "FALSE" Или ВРег(Строка(БезопасныйРежимСтрока)) = "ЛОЖЬ" Или Строка(БезопасныйРежимСтрока) = "0");
                  КонецЕсли;
 
                  Попытка
                                    Данные = Base64Значение(ДанныеBase64);
                  Исключение
                                    Возврат "Ошибка: data_base64 не является корректной base64-строкой.";
                  КонецПопытки;
 
                  ИмяДляОбновления = Аргументы["name"];
                  Обновлено = Ложь;
 
                  Если ЗначениеЗаполнено(ИмяДляОбновления) Тогда
                                    // Обновление существующего расширения по имени
                                    Существующее = Неопределено;
                                    Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
                                                     Если Расширение.Имя = ИмяДляОбновления Тогда
                                                                       Существующее = Расширение;
                                                                       Прервать;
                                                     КонецЕсли;
                                    КонецЦикла;
                                    Если Существующее = Неопределено Тогда
                                                     Возврат "Ошибка: расширение '" + ИмяДляОбновления + "' не установлено — убери name для создания нового.";
                                    КонецЕсли;
                                    Попытка
                                                     Существующее.Записать(Данные);
                                                     ИмяРасширения = Существующее.Имя;
                                                     Обновлено = Истина;
                                    Исключение
                                                     Возврат "Ошибка обновления расширения: " + ОписаниеОшибки();
                                    КонецПопытки;
                  Иначе
                                    Попытка
                                                     Новое = РасширенияКонфигурации.Создать();
                                                     Новое.БезопасныйРежим = БезопасныйРежим;
                                                     Новое.Записать(Данные);
                                                     ИмяРасширения = Новое.Имя;
                                    Исключение
                                                     Возврат "Ошибка загрузки расширения: " + ОписаниеОшибки();
                                    КонецПопытки;
                  КонецЕсли;
 
                  Результат = Новый Соответствие;
                  Результат.Вставить("success", Истина);
                  Результат.Вставить("extension", ИмяРасширения);
                  Результат.Вставить("updated_existing", Обновлено);
                  Результат.Вставить("safe_mode", БезопасныйРежим);
                  Результат.Вставить("note", "Расширение применяется в НОВЫХ сеансах. Для применения перезапусти сеансы (или клиентские подключения). Список — get_configuration_extensions.");
                  Возврат ОбъектВJSON(Результат);
 
КонецФункции
 
// --- delete_extension ---------------------------------------------------------
 
Функция Инструмент_DeleteExtension(Аргументы)
 
                  Имя = Аргументы["name"];
 
                  Найдено = Неопределено;
                  Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
                                    Если Расширение.Имя = Имя Тогда
                                                     Найдено = Расширение;
                                                     Прервать;
                                    КонецЕсли;
                  КонецЦикла;
                  Если Найдено = Неопределено Тогда
                                    Возврат "Ошибка: расширение '" + Имя + "' не установлено. Список — get_configuration_extensions.";
                  КонецЕсли;
 
                  Попытка
                                    Найдено.Удалить();
                  Исключение
                                    Возврат "Ошибка удаления расширения: " + ОписаниеОшибки();
                  КонецПопытки;
 
                  Результат = Новый Соответствие;
                  Результат.Вставить("success", Истина);
                  Результат.Вставить("extension", Имя);
                  Результат.Вставить("note", "Расширение удалено. Изменение вступает в силу для новых сеансов.");
                  Возврат ОбъектВJSON(Результат);
 
КонецФункции
 

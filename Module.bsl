Функция V60_НайтиДокументПоGUID(СтрGUID)
                  СсылкаУИД = XMLЗначение(Тип("УникальныйИдентификатор"), СтрGUID);
                  Для Каждого МДДок Из Метаданные.Документы Цикл
                                    Попытка
                                                     Кандидат = Документы[МДДок.Имя].ПолучитьСсылку(СсылкаУИД);
                                                     Если Кандидат.ПолучитьОбъект() <> Неопределено Тогда
                                                                       Рез = Новый Структура("Ссылка, Тип", Кандидат, МДДок.ПолноеИмя());
                                                                       Возврат Рез;
                                                     КонецЕсли;
                                    Исключение
                                    КонецПопытки;
                  КонецЦикла;
                  Возврат Неопределено;
КонецФункции
 
Функция V60_ИмяРасширенияОбъекта(МДОбъект)
                  Попытка
                                    Расш = МДОбъект.РасширениеКонфигурации();
                                    Если Расш = Неопределено Тогда
                                                     Возврат "";
                                    КонецЕсли;
                                    Возврат Расш.Имя;
                  Исключение
                                    Возврат "";
                  КонецПопытки;
КонецФункции
 
Процедура V60_ДобавитьСвязиУровня(СсылкаДок, Направление, Глубина, Связанные, Посещенные)
                  СтрGUID = XMLСтрока(СсылкаДок.УникальныйИдентификатор());
                  Если Посещенные.Получить(СтрGUID) = Истина Тогда
                                    Возврат;
                  КонецЕсли;
                  Посещенные.Вставить(СтрGUID, Истина);
 
                  Если Направление = "backward" Или Направление = "both" Тогда
                                    Попытка
                                                     Объект = СсылкаДок.ПолучитьОбъект();
                                                     Для Каждого Реквизит Из Объект.Метаданные().Реквизиты Цикл
                                                                       Значение = Объект[Реквизит.Имя];
                                                                       Если ЗначениеЗаполнено(Значение) И ТипЗнч(Значение).Имя() = "ДокументСсылка" Тогда
                                                                                         Элемент = Новый Соответствие;
                                                                                         Элемент.Вставить("ref", XMLСтрока(Значение.УникальныйИдентификатор()));
                                                                                         Элемент.Вставить("type", Значение.Метаданные().ПолноеИмя());
                                                                                         Элемент.Вставить("presentation", Строка(Значение));
                                                                                         Элемент.Вставить("direction", "backward");
                                                                                         Элемент.Вставить("link_attribute", Реквизит.Имя);
                                                                                         Элемент.Вставить("depth", Глубина);
                                                                                         Связанные.Добавить(Элемент);
                                                                       КонецЕсли;
                                                      КонецЦикла;
                                    Исключение
                                    КонецПопытки;
                  КонецЕсли;
 
                  Если Направление = "forward" Или Направление = "both" Тогда
                                    Для Каждого МДДок Из Метаданные.Документы Цикл
                                                     Для Каждого Реквизит Из МДДок.Реквизиты Цикл
                                                                       Если Реквизит.Тип.СодержитТип(ТипЗнч(СсылкаДок)) Тогда
                                                                                         Попытка
                                                                                                          ЗапросСв = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 30 Ссылка ИЗ Документ." + МДДок.Имя + " ГДЕ " + Реквизит.Имя + " = &Осн");
                                                                                                          ЗапросСв.УстановитьПараметр("Осн", СсылкаДок);
                                                                                                          Выб = ЗапросСв.Выполнить().Выбрать();
                                                                                                          Пока Выб.Следующий() Цикл
                                                                                                                            Элемент = Новый Соответствие;
                                                                                                                            Элемент.Вставить("ref", XMLСтрока(Выб.Ссылка.УникальныйИдентификатор()));
                                                                                                                            Элемент.Вставить("type", МДДок.ПолноеИмя());
                                                                                                                            Элемент.Вставить("presentation", Строка(Выб.Ссылка));
                                                                                                                            Элемент.Вставить("direction", "forward");
                                                                                                                            Элемент.Вставить("link_attribute", Реквизит.Имя);
                                                                                                                            Элемент.Вставить("depth", Глубина);
                                                                                                                            Связанные.Добавить(Элемент);
                                                                                                          КонецЦикла;
                                                                                         Исключение
                                                                                         КонецПопытки;
                                                                       КонецЕсли;
                                                      КонецЦикла;
                                    КонецЦикла;
                  КонецЕсли;
КонецПроцедуры
 
Функция V60_РазрешитьСсылкуСправочника(ИмяСправочника, ЗначениеПоиска)
                  Если Не ЗначениеЗаполнено(ЗначениеПоиска) Тогда
                                    Возврат Неопределено;
                  КонецЕсли;
                  Менеджер = Справочники[ИмяСправочника];
                  Попытка
                                    Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(ЗначениеПоиска)));
                                    Если Ссылка.ПолучитьОбъект() <> Неопределено Тогда
                                                     Возврат Ссылка;
                                    КонецЕсли;
                  Исключение
                  КонецПопытки;
                  Ссылка = Менеджер.НайтиПоКоду(Строка(ЗначениеПоиска));
                  Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
                  Ссылка = Менеджер.НайтиПоНаименованию(Строка(ЗначениеПоиска), Истина);
                  Возврат Ссылка;
КонецФункции
 
 

Функция Инструмент_GetObjectUsage(Аргументы)
 
        ПолноеИмя = Аргументы["full_name"];
        Части = РазобратьПолноеИмя(ПолноеИмя);
        Если Части = Неопределено Тогда
                Возврат "Некорректное полное имя: " + ПолноеИмя;
        КонецЕсли;
 
        ПрефиксСсылки = "";
        Если Части.Тип = "Справочник" Тогда ПрефиксСсылки = "СправочникСсылка";
        ИначеЕсли Части.Тип = "Документ" Тогда ПрефиксСсылки = "ДокументСсылка";
        ИначеЕсли Части.Тип = "Перечисление" Тогда ПрефиксСсылки = "ПеречислениеСсылка";
        ИначеЕсли Части.Тип = "ПланВидовХарактеристик" Тогда ПрефиксСсылки = "ПланВидовХарактеристикСсылка";
        ИначеЕсли Части.Тип = "ПланСчетов" Тогда ПрефиксСсылки = "ПланСчетовСсылка";
        ИначеЕсли Части.Тип = "ПланОбмена" Тогда ПрефиксСсылки = "ПланОбменаСсылка";
        Иначе
                Возврат "Поиск использования поддерживается для: Справочник, Документ, Перечисление, ПланВидовХарактеристик, ПланСчетов, ПланОбмена. Получено: " + Части.Тип;
        КонецЕсли;
 
        ИскомыйТип = Неопределено;
        Попытка
                ИскомыйТип = Тип(ПрефиксСсылки + "." + Части.Имя);
        Исключение
                Возврат "Не удалось построить ссылочный тип для: " + ПолноеИмя;
        КонецПопытки;
 
        Найдено = Новый Массив;
 
        Коллекции = Новый Соответствие;
        Коллекции.Вставить("Справочник", Метаданные.Справочники);
        Коллекции.Вставить("Документ", Метаданные.Документы);
        Коллекции.Вставить("РегистрСведений", Метаданные.РегистрыСведений);
        Коллекции.Вставить("РегистрНакопления", Метаданные.РегистрыНакопления);
        Коллекции.Вставить("РегистрБухгалтерии", Метаданные.РегистрыБухгалтерии);
        Коллекции.Вставить("ПланВидовХарактеристик", Метаданные.ПланыВидовХарактеристик);
        Коллекции.Вставить("ПланСчетов", Метаданные.ПланыСчетов);
 
        Для Каждого КЭ Из Коллекции Цикл
                Для Каждого МД Из КЭ.Значение Цикл
                        Попытка
                                ИспользованиеОбъекта_Сканировать(МД, ИскомыйТип, Найдено);
                        Исключение
                        КонецПопытки;
                КонецЦикла;
        КонецЦикла;
 
        Результат = Новый Соответствие;
        Результат.Вставить("object", ПолноеИмя);
        Результат.Вставить("used_in", Найдено);
        Результат.Вставить("count", Найдено.Количество());
        Возврат ОбъектВJSONКомпакт(Результат);
 
КонецФункции
 
Процедура ИспользованиеОбъекта_Сканировать(МД, ИскомыйТип, Найдено)
 
        ПолноеИмяВладельца = МД.ПолноеИмя();
 
        // Реквизиты
        Попытка
                Для Каждого Рекв Из МД.Реквизиты Цикл
                        Если Рекв.Тип.СодержитТип(ИскомыйТип) Тогда
                                ИспользованиеОбъекта_Добавить(Найдено, ПолноеИмяВладельца, "реквизит", Рекв.Имя);
                        КонецЕсли;
                КонецЦикла;
        Исключение КонецПопытки;
 
        // Измерения (для регистров)
        Попытка
                Для Каждого Изм Из МД.Измерения Цикл
                        Если Изм.Тип.СодержитТип(ИскомыйТип) Тогда
                                ИспользованиеОбъекта_Добавить(Найдено, ПолноеИмяВладельца, "измерение", Изм.Имя);
                        КонецЕсли;
                КонецЦикла;
        Исключение КонецПопытки;
 
        // Ресурсы (для регистров)
        Попытка
                Для Каждого Рес Из МД.Ресурсы Цикл
                        Если Рес.Тип.СодержитТип(ИскомыйТип) Тогда
                                ИспользованиеОбъекта_Добавить(Найдено, ПолноеИмяВладельца, "ресурс", Рес.Имя);
                        КонецЕсли;
                КонецЦикла;
        Исключение КонецПопытки;
 
        // Табличные части и их реквизиты
        Попытка
                Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
                        Для Каждого Рекв Из ТЧ.Реквизиты Цикл
                                Если Рекв.Тип.СодержитТип(ИскомыйТип) Тогда
                                        ИспользованиеОбъекта_Добавить(Найдено, ПолноеИмяВладельца, "реквизит ТЧ " + ТЧ.Имя, Рекв.Имя);
                                КонецЕсли;
                        КонецЦикла;
                КонецЦикла;
        Исключение КонецПопытки;
 
КонецПроцедуры
 
Процедура ИспользованиеОбъекта_Добавить(Найдено, ПолноеИмяВладельца, ВидРеквизита, ИмяРеквизита)
        Эл = Новый Соответствие;
        Эл.Вставить("owner", ПолноеИмяВладельца);
        Эл.Вставить("kind", ВидРеквизита);
        Эл.Вставить("attribute", ИмяРеквизита);
        Найдено.Добавить(Эл);
КонецПроцедуры
 

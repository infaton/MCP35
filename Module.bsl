Функция Инструмент_DocumentChain(Аргументы)
                  СтрСсылка = Аргументы["document_ref"];
                  Если Не ЗначениеЗаполнено(СтрСсылка) Тогда
                                    ВызватьИсключение "document_ref обязателен";
                  КонецЕсли;
                  Направление = Аргументы["direction"];
                  Если Не ЗначениеЗаполнено(Направление) Тогда Направление = "both"; КонецЕсли;
                  МаксГлубина = Аргументы["max_depth"];
                  Если МаксГлубина = Неопределено Тогда МаксГлубина = 3; КонецЕсли;
                  Если МаксГлубина > 10 Тогда МаксГлубина = 10; КонецЕсли;
 
                  Найден = V60_НайтиДокументПоGUID(СтрСсылка);
                  Если Найден = Неопределено Тогда
                                    ВызватьИсключение "Документ не найден: " + СтрСсылка;
                  КонецЕсли;
 
                  Связанные = Новый Массив;
                  Посещенные = Новый Соответствие;
                  Очередь = Новый Массив;
                  Эл0 = Новый Структура("ref, depth", Найден.Ссылка, 0);
                  Очередь.Добавить(Эл0);
                  Посещенные.Вставить(СтрСсылка, Истина);
 
                  Пока Очередь.Количество() > 0 Цикл
                                    Тек = Очередь[0];
                                    Очередь.Удалить(0);
                                    ТекГлубина = Тек.depth;
                                    Если ТекГлубина >= МаксГлубина Тогда
                                                     Продолжить;
                                    КонецЕсли;
                                    До = Связанные.Количество();
                                    V60_ДобавитьСвязиУровня(Тек.ref, Направление, ТекГлубина + 1, Связанные, Новый Соответствие);
                                    Для i = До По Связанные.Количество() - 1 Цикл
                                                     Св = Связанные[i];
                                                     НовGUID = Св["ref"];
                                                     Если Посещенные.Получить(НовGUID) <> Истина Тогда
                                                                       Посещенные.Вставить(НовGUID, Истина);
                                                                       НовСсылка = V60_НайтиДокументПоGUID(НовGUID);
                                                                       Если НовСсылка <> Неопределено Тогда
                                                                                         Очередь.Добавить(Новый Структура("ref, depth", НовСсылка.Ссылка, ТекГлубина + 1));
                                                                       КонецЕсли;
                                                     КонецЕсли;
                                    КонецЦикла;
                  КонецЦикла;
 
                  Ответ = Новый Соответствие;
                  Ответ.Вставить("root", СтрСсылка);
                  Ответ.Вставить("root_type", Найден.Тип);
                  Ответ.Вставить("max_depth", МаксГлубина);
                  Ответ.Вставить("chain", Связанные);
                  Ответ.Вставить("count", Связанные.Количество());
                  Возврат ОбъектВJSON(Ответ);
КонецФункции
 
// Безопасная обёртка get_form_structure: в runtime ERP у МДФорма нет коллекции Реквизиты.
Функция Инструмент_V60_GetFormStructureSafe(Аргументы)
                  ПолноеИмя = Аргументы["full_name"];
                  Если Не ЗначениеЗаполнено(ПолноеИмя) Тогда
                                    ВызватьИсключение "Параметр full_name обязателен";
                  КонецЕсли;
                  ИмяФормы = Аргументы["form_name"];
                  МДОбъект = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
                  Если МДОбъект = Неопределено Тогда
                                    ВызватьИсключение "Объект метаданных не найден: " + ПолноеИмя;
                  КонецЕсли;
                  Если Не ЗначениеЗаполнено(ИмяФормы) Тогда
                                    Если МДОбъект.Формы.Количество() = 0 Тогда
                                                     ВызватьИсключение "У объекта нет форм";
                                    КонецЕсли;
                                    МДФорма = МДОбъект.Формы[0];
                                    ИмяФормы = МДФорма.Имя;
                  Иначе
                                    МДФорма = МДОбъект.Формы.Найти(ИмяФормы);
                                    Если МДФорма = Неопределено Тогда
                                                     ВызватьИсключение "Форма не найдена: " + ИмяФормы;
                                    КонецЕсли;
                  КонецЕсли;
 
                  РеквизитыОбъекта = Новый Массив;
                  Для Каждого Рек Из МДОбъект.Реквизиты Цикл
                                    Эл = Новый Соответствие;
                                    Эл.Вставить("name", Рек.Имя);
                                    Эл.Вставить("title", Рек.Синоним);
                                    Попытка
                                                     Эл.Вставить("type", Строка(Рек.Тип));
                                    Исключение
                                                     Эл.Вставить("type", "");
                                    КонецПопытки;
                                    РеквизитыОбъекта.Добавить(Эл);
                  КонецЦикла;
 
                  ТабличныеЧасти = Новый Массив;
                  Для Каждого ТЧ Из МДОбъект.ТабличныеЧасти Цикл
                                    ТабличныеЧасти.Добавить(ТЧ.Имя);
                  КонецЦикла;
 
                  КомандыФормы = Новый Массив;
                  Попытка
                                    Для Каждого Команда Из МДФорма.Команды Цикл
                                                     Эл = Новый Соответствие;
                                                     Эл.Вставить("name", Команда.Имя);
                                                     Эл.Вставить("title", Команда.Заголовок);
                                                     КомандыФормы.Добавить(Эл);
                                    КонецЦикла;
                  Исключение
                  КонецПопытки;
 
                  ВсеФормы = Новый Массив;
                  Для Каждого Ф Из МДОбъект.Формы Цикл
                                    ВсеФормы.Добавить(Ф.Имя);
                  КонецЦикла;
 
                  Ответ = Новый Соответствие;
                  Ответ.Вставить("object", ПолноеИмя);
                  Ответ.Вставить("form_name", ИмяФормы);
                  Ответ.Вставить("form_synonym", МДФорма.Синоним);
                  Ответ.Вставить("attributes", РеквизитыОбъекта);
                  Ответ.Вставить("attribute_count", РеквизитыОбъекта.Количество());
                  Ответ.Вставить("tabular_sections", ТабличныеЧасти);
                  Ответ.Вставить("commands", КомандыФормы);
                  Ответ.Вставить("command_count", КомандыФормы.Количество());
                  Ответ.Вставить("available_forms", ВсеФормы);
                  Ответ.Вставить("source", "v6_object_metadata");
                  Ответ.Вставить("note", "Реквизиты формы в runtime недоступны; возвращены реквизиты объекта и команды формы.");
                  Возврат ОбъектВJSON(Ответ);
КонецФункции
 

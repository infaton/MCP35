Функция Инструмент_GetStockByWarehouse(Аргументы)
                  ИмяРег = Аргументы["register_name"];
                  Если Не ЗначениеЗаполнено(ИмяРег) Тогда
                                    ИмяРег = "РегистрНакопления.ТоварыНаСкладах";
                  КонецЕсли;
                  Части = РазобратьПолноеИмя(ИмяРег);
                  Если Части = Неопределено Или НРег(Части.Тип) <> "регистрнакопления" Тогда
                                    Возврат "Ожидается РегистрНакопления, получено: " + ИмяРег;
                  КонецЕсли;
                  ИмяРегистра = Части.Имя;
 
                  Макс = Аргументы["max_rows"];
                  Если Макс = Неопределено Тогда Макс = 200; КонецЕсли;
                  Если Макс > 500 Тогда Макс = 500; КонецЕсли;
 
                  Условия = Новый Массив;
                  ЕстьСклад = Ложь;
                  ЕстьНом = Ложь;
                  Если ЗначениеЗаполнено(Аргументы["warehouse"]) Тогда
                                    Склад = V60_РазрешитьСсылкуСправочника("Склады", Аргументы["warehouse"]);
                                    Если ЗначениеЗаполнено(Склад) Тогда
                                                     Условия.Добавить("Склад = &Склад");
                                                     ЕстьСклад = Истина;
                                    КонецЕсли;
                  КонецЕсли;
                  Если ЗначениеЗаполнено(Аргументы["nomenclature"]) Тогда
                                    Ном = V60_РазрешитьСсылкуСправочника("Номенклатура", Аргументы["nomenclature"]);
                                    Если ЗначениеЗаполнено(Ном) Тогда
                                                     Условия.Добавить("Номенклатура = &Ном");
                                                      ЕстьНом = Истина;
                                    КонецЕсли;
                  КонецЕсли;
 
                  УсловиеВТ = "";
                  Если Условия.Количество() > 0 Тогда
                                    УсловиеВТ = СтрСоединить(Условия, " И ");
                  КонецЕсли;
 
                  БазаЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Макс, "ЧГ=0")
                                    + " Номенклатура, Склад, ВНаличииОстаток КАК ВНаличии"
                                    + " ИЗ РегистрНакопления." + ИмяРегистра + ".Остатки(";
                  Если ЗначениеЗаполнено(УсловиеВТ) Тогда
                                    ТекстЗапроса = БазаЗапроса + ", " + УсловиеВТ + ")";
                  Иначе
                                    ТекстЗапроса = БазаЗапроса + ",)";
                  КонецЕсли;
 
                  Запрос = Новый Запрос(ТекстЗапроса);
                  Если ЕстьСклад Тогда
                                    Запрос.УстановитьПараметр("Склад", Склад);
                  КонецЕсли;
                  Если ЕстьНом Тогда
                                    Запрос.УстановитьПараметр("Ном", Ном);
                  КонецЕсли;
 
                  Попытка
                                    Результат = Запрос.Выполнить();
                  Исключение
                                    Возврат "Ошибка get_stock_by_warehouse: " + ОписаниеОшибки();
                  КонецПопытки;
 
                  Строки = Новый Массив;
                  Выборка = Результат.Выбрать();
                  Пока Выборка.Следующий() Цикл
                                    Стр = Новый Соответствие;
                                    Стр.Вставить("nomenclature", Строка(Выборка.Номенклатура));
                                    Стр.Вставить("warehouse", Строка(Выборка.Склад));
                                    Стр.Вставить("balance", Выборка.ВНаличии);
                                    Строки.Добавить(Стр);
                  КонецЦикла;
 
                  Ответ = Новый Соответствие;
                  Ответ.Вставить("register", ИмяРег);
                  Ответ.Вставить("rows", Строки);
                  Ответ.Вставить("count", Строки.Количество());
                  Возврат ОбъектВJSONКомпакт(Ответ);
КонецФункции
 
Функция Инструмент_GetUnfulfilledOrderLines(Аргументы)
                  СтрGUID = Аргументы["document_ref"];
                  ТипДок = Аргументы["document_type"];
                  ИмяТЧ = Аргументы["tabular_section"];
                  Если Не ЗначениеЗаполнено(ИмяТЧ) Тогда ИмяТЧ = "Товары"; КонецЕсли;
                  ПолеКол = Аргументы["quantity_field"];
                  Если Не ЗначениеЗаполнено(ПолеКол) Тогда ПолеКол = "Количество"; КонецЕсли;
                  ПолеОтгр = Аргументы["shipped_field"];
 
                  Найден = V60_НайтиДокументПоGUID(СтрGUID);
                  Если Найден = Неопределено Тогда
                                    Возврат "Документ не найден";
                  КонецЕсли;
                  Об = Найден.Ссылка.ПолучитьОбъект();
                  Строки = Новый Массив;
                  Ном = 0;
                  Для Каждого Стр Из Об[ИмяТЧ] Цикл
                                    Ном = Ном + 1;
                                    Кол = 0;
                                    Отгр = 0;
                                    Попытка Кол = Стр[ПолеКол]; Исключение КонецПопытки;
                                    Если ЗначениеЗаполнено(ПолеОтгр) Тогда
                                                     Попытка Отгр = Стр[ПолеОтгр]; Исключение КонецПопытки;
                                    КонецЕсли;
                                    Остаток = Кол - Отгр;
                                    Если Остаток > 0 Тогда
                                                     Эл = Новый Соответствие;
                                                     Эл.Вставить("line_number", Ном);
                                                     Эл.Вставить("quantity", Кол);
                                                     Эл.Вставить("shipped", Отгр);
                                                     Эл.Вставить("remaining", Остаток);
                                                     Строки.Добавить(Эл);
                                    КонецЕсли;
                  КонецЦикла;
                  Рез = Новый Соответствие;
                  Рез.Вставить("document", СтрGUID);
                  Рез.Вставить("document_type", Найден.Тип);
                  Рез.Вставить("lines", Строки);
                  Рез.Вставить("count", Строки.Количество());
                  Возврат ОбъектВJSON(Рез);
КонецФункции
 
Функция Инструмент_GetReservationStatus(Аргументы)
                  ИмяРег = Аргументы["register_name"];
                  Если Не ЗначениеЗаполнено(ИмяРег) Тогда
                                    Возврат "register_name обязателен (напр. РегистрНакопления.ТоварыКОтгрузке)";
                  КонецЕсли;
                  Измерения = Новый Соответствие;
                  Если ЗначениеЗаполнено(Аргументы["nomenclature"]) Тогда
                                    Ном = V60_РазрешитьСсылкуСправочника("Номенклатура", Аргументы["nomenclature"]);
                                    Если ЗначениеЗаполнено(Ном) Тогда Измерения.Вставить("Номенклатура", Ном); КонецЕсли;
                  КонецЕсли;
                  Если ЗначениеЗаполнено(Аргументы["warehouse"]) Тогда
                                    Склад = V60_РазрешитьСсылкуСправочника("Склады", Аргументы["warehouse"]);
                                    Если ЗначениеЗаполнено(Склад) Тогда Измерения.Вставить("Склад", Склад); КонецЕсли;
                  КонецЕсли;
                  Арг = Новый Соответствие;
                  Арг.Вставить("full_name", ИмяРег);
                  Арг.Вставить("balance_type", "balance");
                  Арг.Вставить("dimensions", Измерения);
                  Возврат Инструмент_GetRegisterTotals(Арг);
КонецФункции
 
Функция Инструмент_GetBusinessProcessTasks(Аргументы)
                  Фильтр = Аргументы["business_process"];
                  ТолькоАкт = Аргументы["only_active"];
                  Если ТолькоАкт = Неопределено Тогда ТолькоАкт = Истина; КонецЕсли;
                  Макс = Аргументы["max_rows"];
                  Если Макс = Неопределено Тогда Макс = 100; КонецЕсли;
 
                  Задачи = Новый Массив;
                  Если Метаданные.БизнесПроцессы.Количество() = 0 Тогда
                                    Пусто = Новый Соответствие;
                                    Пусто.Вставить("message", "Бизнес-процессы не используются в конфигурации");
                                    Возврат ОбъектВJSONКомпакт(Пусто);
                  КонецЕсли;
 
                  Для Каждого МДБП Из Метаданные.БизнесПроцессы Цикл
                                    Если ЗначениеЗаполнено(Фильтр) И МДБП.Имя <> Фильтр Тогда
                                                     Продолжить;
                                    КонецЕсли;
                                    Попытка
                                                     Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Макс, "ЧГ=0") + " Ссылка, Наименование, Выполнена, Дата ИЗ БизнесПроцесс." + МДБП.Имя
                                                                       + ?(ТолькоАкт, " ГДЕ НЕ Выполнена", ""));
                                                     Выб = Запрос.Выполнить().Выбрать();
                                                     Пока Выб.Следующий() Цикл
                                                                       Эл = Новый Соответствие;
                                                                       Эл.Вставить("ref", XMLСтрока(Выб.Ссылка.УникальныйИдентификатор()));
                                                                       Эл.Вставить("presentation", Выб.Наименование);
                                                                       Эл.Вставить("completed", Выб.Выполнена);
                                                                       Эл.Вставить("date", Формат(Выб.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
                                                                       Эл.Вставить("business_process", МДБП.ПолноеИмя());
                                                                       Задачи.Добавить(Эл);
                                                     КонецЦикла;
                                    Исключение
                                    КонецПопытки;
                  КонецЦикла;
                  Возврат ОбъектВJSONКомпакт(Задачи);
КонецФункции
 
Функция Инструмент_SnapshotDocumentState(Аргументы)
                  Арг = Новый Соответствие;
                  Арг.Вставить("full_name", Аргументы["full_name"]);
                  Арг.Вставить("guid", Аргументы["guid"]);
                  Текст = Инструмент_GetObjectByRef(Арг);
                  ВключитьДвиж = Аргументы["include_movements"];
                  Если ВключитьДвиж = Истина Тогда
                                    Движ = Новый Соответствие;
                                    Движ.Вставить("full_name", Аргументы["full_name"]);
                                    Попытка
                                                     Движ.Вставить("movements", Инструмент_GetDocumentMovements(Движ));
                                    Исключение
                                    КонецПопытки;
                                    Рез = Новый Соответствие;
                                    Рез.Вставить("snapshot", Текст);
                                    Рез.Вставить("movements", Движ);
                                    Возврат ОбъектВJSON(Рез);
                  КонецЕсли;
                  Рез = Новый Соответствие;
                  Рез.Вставить("snapshot", Текст);
                  Рез.Вставить("captured_at", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
                  Возврат ОбъектВJSON(Рез);
КонецФункции
 
Функция Инструмент_CompareSnapshots(Аргументы)
                  А = Аргументы["snapshot_a"];
                  Б = Аргументы["snapshot_b"];
                  Если Не ЗначениеЗаполнено(А) Или Не ЗначениеЗаполнено(Б) Тогда
                                    Возврат "Нужны snapshot_a и snapshot_b (JSON из snapshot_document_state)";
                  КонецЕсли;
                  Рез = Новый Соответствие;
                  Рез.Вставить("equal", А = Б);
                  Рез.Вставить("length_a", СтрДлина(А));
                  Рез.Вставить("length_b", СтрДлина(Б));
                  Если А <> Б Тогда
                                    Рез.Вставить("note", "Для детального diff передайте снимки агенту или сравните поля вручную; строковое сравнение JSON.");
                  КонецЕсли;
                  Возврат ОбъектВJSON(Рез);
КонецФункции
 

Функция Инструмент_AnalyzeImpact(Аргументы)
 
        ПолноеИмя = Аргументы["full_name"];
        МДОбъект = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
        Если МДОбъект = Неопределено Тогда
                Возврат "Объект не найден: " + ПолноеИмя;
        КонецЕсли;
 
        Результат = Новый Соответствие;
        Результат.Вставить("object", ПолноеИмя);
        Результат.Вставить("object_synonym", МДОбъект.Синоним);
 
        // === ПРЯМОЕ ВЛИЯНИЕ: если это документ — по каким регистрам он делает движения ===
        ВлияетНаРегистры = Новый Массив;
        Попытка
                Для Каждого Рег Из МДОбъект.Движения Цикл
                        Инфо = Новый Соответствие;
                        Инфо.Вставить("full_name", Рег.ПолноеИмя());
                        Инфо.Вставить("name", Рег.Имя);
                        Инфо.Вставить("synonym", Рег.Синоним);
                        ВлияетНаРегистры.Добавить(Инфо);
                КонецЦикла;
        Исключение
                // У объекта нет свойства "Движения" (не документ) — это нормально
        КонецПопытки;
        Результат.Вставить("affects_registers", ВлияетНаРегистры);
 
        // === ОБРАТНОЕ ВЛИЯНИЕ: какие документы пишут движения в этот регистр ===
        ПишутДокументы = Новый Массив;
        Для Каждого МДДок Из Метаданные.Документы Цикл
                Попытка
                        Для Каждого Рег Из МДДок.Движения Цикл
                                Если Рег = МДОбъект Тогда
                                        Инфо = Новый Соответствие;
                                        Инфо.Вставить("full_name", МДДок.ПолноеИмя());
                                        Инфо.Вставить("name", МДДок.Имя);
                                        Инфо.Вставить("synonym", МДДок.Синоним);
                                        ПишутДокументы.Добавить(Инфо);
                                        Прервать;
                                КонецЕсли;
                        КонецЦикла;
                Исключение
                КонецПопытки;
        КонецЦикла;
        Результат.Вставить("written_by_documents", ПишутДокументы);
 
        Результат.Вставить("affects_count", ВлияетНаРегистры.Количество());
        Результат.Вставить("written_by_count", ПишутДокументы.Количество());
 
        Возврат ОбъектВJSONКомпакт(Результат);
 
КонецФункции
 

        ИначеЕсли ИмяИнструмента = "get_form_module_text" Тогда Возврат Инструмент_GetFormModuleText(Аргументы);
        ИначеЕсли ИмяИнструмента = "run_data_processor" Тогда Возврат Инструмент_RunDataProcessor(Аргументы);

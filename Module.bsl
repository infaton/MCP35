Функция Инструмент_GetReportOptions(Аргументы)
                  ИмяОтчёта = СтрЗаменить(Строка(Аргументы["report"]), "Отчет.", "");
                  МД = Метаданные.Отчеты.Найти(ИмяОтчёта);
                  Если МД = Неопределено Тогда Возврат "Отчёт не найден: " + ИмяОтчёта; КонецЕсли;
                  Результат = Новый Соответствие;
                  Результат.Вставить("report", "Отчет." + ИмяОтчёта);
                  Результат.Вставить("synonym", МД.Синоним);
                  Параметры = Новый Массив;
                  Попытка
                                    ОбъектОтчёта = Отчеты[ИмяОтчёта].Создать();
                                    Схема = ОбъектОтчёта.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
                                    Если Схема <> Неопределено Тогда
                                                     Для Каждого П Из Схема.Параметры Цикл
                                                                       ПС = Новый Соответствие;
                                                                       ПС.Вставить("name", П.Имя);
                                                                       ПС.Вставить("title", Строка(П.Заголовок));
                                                                       Параметры.Добавить(ПС);
                                                     КонецЦикла;
                                    КонецЕсли;
                  Исключение
                                    Результат.Вставить("schema_note", "Не удалось прочитать ОсновнаяСхемаКомпоновкиДанных: " + ОписаниеОшибки());
                  КонецПопытки;
                  Результат.Вставить("parameters", Параметры);
                  Возврат ОбъектВJSONКомпакт(Результат);
КонецФункции
 
Функция Инструмент_RunReport(Аргументы)
                  ИмяОтчёта = СтрЗаменить(Строка(Аргументы["report"]), "Отчет.", "");
                  МД = Метаданные.Отчеты.Найти(ИмяОтчёта);
                  Если МД = Неопределено Тогда Возврат "Отчёт не найден: " + ИмяОтчёта; КонецЕсли;
 
                  Схема = Неопределено;
                  Попытка
                                    ОбъектОтчёта = Отчеты[ИмяОтчёта].Создать();
                                    Схема = ОбъектОтчёта.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
                  Исключение
                                    Возврат "run_report: у отчёта нет макета ОсновнаяСхемаКомпоновкиДанных — вероятно, это не СКД-отчёт (регламентированный или на обычном макете), прямая компоновка неприменима. Детали: " + ОписаниеОшибки();
                  КонецПопытки;
                  Если Схема = Неопределено Тогда
                                    Возврат "У отчёта нет основной схемы компоновки данных (ОсновнаяСхемаКомпоновкиДанных) — это не СКД-отчёт";
                  КонецЕсли;
 
                  // B3 (v4.4.2): выражения параметров вида ТекущаяДатаСеанса() не вычисляются
                  // при прямой компоновке вне формы отчёта — подменяем на готовое значение.
                  НормализоватьВыраженияПараметровСхемы(Схема);
 
                  Настройки = Схема.НастройкиПоУмолчанию;
 
                  // B2 (v4.4): если задан group_by — перестраиваем разрез; иначе всё как раньше.
                  РазрезПоля = Аргументы["group_by"];
                  Если ТипЗнч(РазрезПоля) = Тип("Массив") И РазрезПоля.Количество() > 0 Тогда
                                    Попытка
                                                     ПрименитьРазрезКНастройкам(Настройки, Аргументы["resources"], РазрезПоля, Схема);
                                    Исключение
                                                     Возврат "Не удалось применить разрез group_by: " + ОписаниеОшибки()
                                                                       + ". Проверьте имена полей через get_report_options.";
                                    КонецПопытки;
                  КонецЕсли;
 
                  Параметры = Аргументы["parameters"];
                  ПериодНач = '00010101';
                  ПериодКон = '00010101';
                  Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
                                    Для Каждого П Из Параметры Цикл
                                                     Значение = П.Значение;
                                                     Если ТипЗнч(Значение) = Тип("Строка") Тогда
                                                                       Попытка
                                                                                         ВозможнаяДата = ПреобразоватьДату(Значение);
                                                                                         Если ЗначениеЗаполнено(ВозможнаяДата) Тогда Значение = ВозможнаяДата; КонецЕсли;
                                                                       Исключение
                                                                       КонецПопытки;
                                                     КонецЕсли;
                                                     // B4 (v4.4.3): запоминаем границы периода — понадобятся для параметров
                                                     // типа СтандартныйПериод (у которых НачалоПериода/КонецПериода в схеме
                                                     // заданы выражениями и напрямую не устанавливаются).
                                                     Если ТипЗнч(Значение) = Тип("Дата") Тогда
                                                                       Если ВРег(П.Ключ) = "НАЧАЛОПЕРИОДА" Тогда ПериодНач = Значение; КонецЕсли;
                                                                       Если ВРег(П.Ключ) = "КОНЕЦПЕРИОДА" Тогда ПериодКон = Значение; КонецЕсли;
                                                     КонецЕсли;
                                                     ЗначениеП = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(П.Ключ));
                                                     Если ЗначениеП <> Неопределено Тогда
                                                                       // B4: дату/строку в параметр типа СтандартныйПериод не кладём —
                                                                       // период собирается ниже в ПрименитьПериодКПараметрам
                                                                       Если ТипЗнч(ЗначениеП.Значение) = Тип("СтандартныйПериод")
                                                                                         И ТипЗнч(Значение) <> Тип("СтандартныйПериод") Тогда
                                                                                         Продолжить;
                                                                       КонецЕсли;
                                                                       ЗначениеП.Использование = Истина;
                                                                       ЗначениеП.Значение = Значение;
                                                     КонецЕсли;
                                    КонецЦикла;
                  КонецЕсли;
                  // B4 (v4.4.3): НачалоПериода/КонецПериода из аргументов -> СтандартныйПериод
                  Если ЗначениеЗаполнено(ПериодНач) Или ЗначениеЗаполнено(ПериодКон) Тогда
                                    ПрименитьПериодКПараметрам(Настройки, ПериодНач, ПериодКон);
                  КонецЕсли;
 
                  Попытка
                                    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
                                    МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанных"));
                                    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
                                    // B6 (v4.4.8): 4-й параметр ВозможностьИспользованияВнешнихФункций=Истина —
                                    // разрешает вызовы функций общих модулей (КомпоновкаДанныхСервер.X) и
                                    // глобального контекста (Константы.X.Получить()) в выражениях полей СКД.
                                    // Без него типовые отчёты ЕРП падали на выводе «Синтаксическая ошибка ...».
                                    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
                                    ТабДок = Новый ТабличныйДокумент;
                                    ВыводВТабДок = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
                                    ВыводВТабДок.УстановитьДокумент(ТабДок);
                                    ВыводВТабДок.НачатьВывод();
                                    ВыводВТабДок.Вывести(ПроцессорКомпоновки);
                                    ВыводВТабДок.ЗакончитьВывод();
                  Исключение
                                    ТекстОшибкиКомпоновки = ОписаниеОшибки();
                                    Если СтрНайти(ТекстОшибкиКомпоновки, "Не найден внешний набор данных") > 0 Тогда
                                                     Возврат "run_report: отчёт использует ВНЕШНИЕ наборы данных, которые заполняются кодом формы отчёта — прямая компоновка невозможна, такой отчёт через run_report не отдаётся. Детали: " + ТекстОшибкиКомпоновки;
                                    ИначеЕсли СтрНайти(ТекстОшибкиКомпоновки, "не связанных наборов данных") > 0 Тогда
                                                     Возврат "run_report: настройки по умолчанию тянут поля из наборов, связываемых логикой формы (напр. по виду цены). Задайте нужные параметры (см. get_report_options, напр. ВидЦены/ОценкаЗапасовПоВидуЦен) или отчёт не отдаётся прямой компоновкой. Детали: " + ТекстОшибкиКомпоновки;
                                    ИначеЕсли СтрНайти(ТекстОшибкиКомпоновки, "Не установлено значение параметра") > 0 Тогда
                                                     Возврат "run_report: отчёту нужен параметр, который в форме задаётся логикой отчёта (частый случай — Вид цены). Задайте его явно в parameters (см. get_report_options, напр. ВидЦены/ОценкаЗапасовПоВидуЦен). Детали: " + ТекстОшибкиКомпоновки;
                                    ИначеЕсли СтрНайти(ТекстОшибкиКомпоновки, "Синтаксическая ошибка") > 0 Тогда
                                                     Возврат "run_report: в выражении поля/параметра используется функция, недоступная в контексте прямой компоновки. Детали: " + ТекстОшибкиКомпоновки;
                                    Иначе
                                                     Возврат "Ошибка компоновки отчёта: " + ТекстОшибкиКомпоновки;
                                    КонецЕсли;
                  КонецПопытки;
 
                  МаксСтрок = Аргументы["max_rows"];
                  Если Не ЗначениеЗаполнено(МаксСтрок) Тогда МаксСтрок = 500; КонецЕсли;
                  Если МаксСтрок > 5000 Тогда МаксСтрок = 5000; КонецЕсли;
 
                  ВысотаТаб = ТабДок.ВысотаТаблицы;
                  ШиринаТаб = ТабДок.ШиринаТаблицы;
                  Строки = Новый Массив;
                  Счётчик = 0;
                  Для Ряд = 1 По ВысотаТаб Цикл
                                    Если Счётчик >= МаксСтрок Тогда Прервать; КонецЕсли;
                                    ЯчейкиРяда = Новый Массив;
                                    ЕстьТекст = Ложь;
                                    Для Кол = 1 По ШиринаТаб Цикл
                                                     ТекстЯч = СокрЛП(ТабДок.Область(Ряд, Кол, Ряд, Кол).Текст);
                                                     ЯчейкиРяда.Добавить(ТекстЯч);
                                                     Если Не ПустаяСтрока(ТекстЯч) Тогда ЕстьТекст = Истина; КонецЕсли;
                                    КонецЦикла;
                                    Если ЕстьТекст Тогда
                                                     Строки.Добавить(ЯчейкиРяда);
                                                     Счётчик = Счётчик + 1;
                                    КонецЕсли;
                  КонецЦикла;
 
                  Результат = Новый Соответствие;
                  Результат.Вставить("report", "Отчет." + ИмяОтчёта);
                  Результат.Вставить("format", "spreadsheet_rows");
                  Результат.Вставить("rows", Строки);
                  Результат.Вставить("count", Счётчик);
                  Результат.Вставить("truncated", Счётчик >= МаксСтрок);
                  Возврат ОбъектВJSONКомпакт(Результат);
КонецФункции
 
Функция Инструмент_ListDataProcessors(Аргументы)
                  ЗапросПоиска = Аргументы["query"];
                  СтрокаПоиска = ?(ЗапросПоиска = Неопределено, "", НРег(ЗапросПоиска));
                  Массив = Новый Массив;
                  Для Каждого Об Из Метаданные.Обработки Цикл
                                    Если ЗначениеЗаполнено(СтрокаПоиска)
                                                     И СтрНайти(НРег(Об.Имя), СтрокаПоиска) = 0
                                                     И СтрНайти(НРег(Об.Синоним), СтрокаПоиска) = 0 Тогда
                                                     Продолжить;
                                    КонецЕсли;
                                    Эл = Новый Соответствие;
                                    Эл.Вставить("full_name", Об.ПолноеИмя());
                                    Эл.Вставить("name", Об.Имя);
                                    Эл.Вставить("synonym", Об.Синоним);
                                    Массив.Добавить(Эл);
                  КонецЦикла;
                  Возврат ОбъектВJSONКомпакт(Массив);
КонецФункции
 
// Динамический вызов метода объекта/менеджера с массивом аргументов (до 6).
Функция ВызватьСМассивомАргументов(Цель, ИмяМетода, Арги, ВозвращаетЗначение)
                  П0 = Неопределено; П1 = Неопределено; П2 = Неопределено;
                  П3 = Неопределено; П4 = Неопределено; П5 = Неопределено;
                  К = ?(Арги = Неопределено, 0, Арги.Количество());
                  Если К > 6 Тогда ВызватьИсключение "call_*: поддерживается не более 6 аргументов"; КонецЕсли;
                  Если К > 0 Тогда П0 = Арги[0]; КонецЕсли;
                  Если К > 1 Тогда П1 = Арги[1]; КонецЕсли;
                  Если К > 2 Тогда П2 = Арги[2]; КонецЕсли;
                  Если К > 3 Тогда П3 = Арги[3]; КонецЕсли;
                  Если К > 4 Тогда П4 = Арги[4]; КонецЕсли;
                  Если К > 5 Тогда П5 = Арги[5]; КонецЕсли;
                  СписокП = "";
                  Для i = 0 По К - 1 Цикл
                                    СписокП = СписокП + ?(i > 0, ", ", "") + "П" + Формат(i, "ЧГ=0");
                  КонецЦикла;
                  Рез = Неопределено;
                  Если ВозвращаетЗначение Тогда
                                    Выполнить("Рез = Цель." + ИмяМетода + "(" + СписокП + ")");
                  Иначе
                                    Выполнить("Цель." + ИмяМетода + "(" + СписокП + ")");
                  КонецЕсли;
                  Возврат Рез;
КонецФункции
 
Функция Инструмент_CallObjectMethod(Аргументы)
                  ПолноеИмя = Строка(Аргументы["full_name"]);
                  ИмяМетода = Строка(Аргументы["method"]);
                  Если Не ЗначениеЗаполнено(ИмяМетода) Тогда Возврат "Не задан method"; КонецЕсли;
                  Арги = Аргументы["args"];
                  ВозвращаетЗначение = Аргументы["returns_value"];
                  Если ВозвращаетЗначение = Неопределено Тогда ВозвращаетЗначение = Истина; КонецЕсли;
                  РефСтр = Аргументы["object_ref"];
 
                  Части = РазобратьПолноеИмя(ПолноеИмя);
                  Если Части = Неопределено Тогда Возврат "Некорректное full_name: " + ПолноеИмя; КонецЕсли;
                  Менеджер = ПолучитьМенеджерОбъекта(Части.Тип, Части.Имя);
                  Если Менеджер = Неопределено Тогда Возврат "Не удалось получить менеджер: " + ПолноеИмя; КонецЕсли;
 
                  Цель = Менеджер;
                  Если ЗначениеЗаполнено(РефСтр) Тогда
                                    Попытка
                                                     Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(РефСтр)));
                                                     Цель = Ссылка.ПолучитьОбъект();
                                    Исключение
                                                     Возврат "Не удалось получить объект по ссылке: " + ОписаниеОшибки();
                                    КонецПопытки;
                                    Если Цель = Неопределено Тогда Возврат "Объект не найден по ссылке"; КонецЕсли;
                  КонецЕсли;
 
                  Попытка
                                    Рез = ВызватьСМассивомАргументов(Цель, ИмяМетода, Арги, ВозвращаетЗначение);
                  Исключение
                                    Возврат "Ошибка вызова метода " + ИмяМетода + ": " + ОписаниеОшибки();
                  КонецПопытки;
 
                  Результат = Новый Соответствие;
                  Результат.Вставить("full_name", ПолноеИмя);
                  Результат.Вставить("method", ИмяМетода);
                  Результат.Вставить("result", ЗначениеДляJSON(Рез));
                  Возврат ОбъектВJSONКомпакт(Результат);
КонецФункции
 
Функция Инструмент_CallFunction(Аргументы)
                  ИмяМодуля = Строка(Аргументы["module"]);
                  ИмяФункции = Строка(Аргументы["function"]);
                  Если Не ЗначениеЗаполнено(ИмяМодуля) Или Не ЗначениеЗаполнено(ИмяФункции) Тогда Возврат "Нужны module и function"; КонецЕсли;
                  Арги = Аргументы["args"];
                  ВозвращаетЗначение = Аргументы["returns_value"];
                  Если ВозвращаетЗначение = Неопределено Тогда ВозвращаетЗначение = Истина; КонецЕсли;
 
                  П0 = Неопределено; П1 = Неопределено; П2 = Неопределено;
                  П3 = Неопределено; П4 = Неопределено; П5 = Неопределено;
                  К = ?(Арги = Неопределено, 0, Арги.Количество());
                  Если К > 6 Тогда Возврат "call_function: не более 6 аргументов"; КонецЕсли;
                  Если К > 0 Тогда П0 = Арги[0]; КонецЕсли;
                  Если К > 1 Тогда П1 = Арги[1]; КонецЕсли;
                  Если К > 2 Тогда П2 = Арги[2]; КонецЕсли;
                  Если К > 3 Тогда П3 = Арги[3]; КонецЕсли;
                  Если К > 4 Тогда П4 = Арги[4]; КонецЕсли;
                  Если К > 5 Тогда П5 = Арги[5]; КонецЕсли;
                  СписокП = "";
                  Для i = 0 По К - 1 Цикл
                                    СписокП = СписокП + ?(i > 0, ", ", "") + "П" + Формат(i, "ЧГ=0");
                  КонецЦикла;
 
                  Рез = Неопределено;
                  Попытка
                                    Если ВозвращаетЗначение Тогда
                                                     Выполнить("Рез = " + ИмяМодуля + "." + ИмяФункции + "(" + СписокП + ")");
                                    Иначе
                                                     Выполнить(ИмяМодуля + "." + ИмяФункции + "(" + СписокП + ")");
                                    КонецЕсли;
                  Исключение
                                    Возврат "Ошибка вызова функции " + ИмяМодуля + "." + ИмяФункции + ": " + ОписаниеОшибки();
                  КонецПопытки;
 
                  Результат = Новый Соответствие;
                  Результат.Вставить("module", ИмяМодуля);
                  Результат.Вставить("function", ИмяФункции);
                  Результат.Вставить("result", ЗначениеДляJSON(Рез));
                  Возврат ОбъектВJSONКомпакт(Результат);

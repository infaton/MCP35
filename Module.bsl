#Область ГруппаЗ_НовыеИнструменты_v21
 
// =========================================================================
// Группа З: Новые инструменты v2.1 (10 инструментов, #42–#51)
// =========================================================================
 
// #42 — get_balance: Остатки/обороты регистров бухгалтерии
Функция Инструмент_GetBalance(Аргументы)
        
        ИмяРегистра = Аргументы["register_name"];
        Если ИмяРегистра = Неопределено ИЛИ ИмяРегистра = "" Тогда
                ИмяРегистра = "Хозрасчетный";
        КонецЕсли;
        
        КодСчёта = Аргументы["account_code"];
        Если КодСчёта = Неопределено ИЛИ КодСчёта = "" Тогда
                ВызватьИсключение "Параметр account_code обязателен";
        КонецЕсли;
        
        ТипОстатков = Аргументы["balance_type"];
        Если ТипОстатков = Неопределено ИЛИ ТипОстатков = "" Тогда
                ТипОстатков = "balance";
        КонецЕсли;
        
        // Находим регистр бухгалтерии
        МДРегистр = Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра);
        Если МДРегистр = Неопределено Тогда
                ВызватьИсключение "Регистр бухгалтерии не найден: " + ИмяРегистра;
        КонецЕсли;
        
        Менеджер = РегистрыБухгалтерии[ИмяРегистра];
        
        // Определяем виртуальную таблицу
        Если ТипОстатков = "turnovers" Тогда
                ИмяВТ = "Обороты";
        ИначеЕсли ТипОстатков = "balance_and_turnovers" Тогда
                ИмяВТ = "ОстаткиИОбороты";
        Иначе
                ИмяВТ = "Остатки";
        КонецЕсли;
        
        // Строим текст запроса
        ТекстЗапроса = "ВЫБРАТЬ * ИЗ РегистрБухгалтерии." + ИмяРегистра + "." + ИмяВТ + "(";
        
        // Параметры виртуальной таблицы
        ПараметрыВТ = Новый Массив;
        
        // Период
        ПериодС = Аргументы["period_from"];
        ПериодПо = Аргументы["period_to"];
        Если ПериодС <> Неопределено И ПериодС <> "" Тогда
                ПараметрыВТ.Добавить("&ПериодС");
        Иначе
                ПараметрыВТ.Добавить("");
        КонецЕсли;
        Если ПериодПо <> Неопределено И ПериодПо <> "" Тогда
                ПараметрыВТ.Добавить("&ПериодПо");
        Иначе
                ПараметрыВТ.Добавить("");
        КонецЕсли;
        
        // Условие по счёту
        ПараметрыВТ.Добавить("Счёт = &Счёт");
        
        // Субконто — пока пустой
        ПараметрыВТ.Добавить("");
        
        ТекстЗапроса = ТекстЗапроса + СтрСоединить(ПараметрыВТ, ", ") + ")";
        
        // Дополнительные условия по измерениям
        ФильтрИзмерений = Аргументы["dimensions"];
        Если ФильтрИзмерений <> Неопределено И ТипЗнч(ФильтрИзмерений) = Тип("Соответствие") Тогда
                Условия = Новый Массив;
                Для Каждого КЗ Из ФильтрИзмерений Цикл
                        Условия.Добавить(КЗ.Ключ + " = &Изм_" + КЗ.Ключ);
                КонецЦикла;
                Если Условия.Количество() > 0 Тогда
                        ТекстЗапроса = ТекстЗапроса + " ГДЕ " + СтрСоединить(Условия, " И ");
                КонецЕсли;
        КонецЕсли;
        
        Запрос = Новый Запрос(ТекстЗапроса);
        
        // Параметры
        ПланСчетов = Метаданные.РегистрыБухгалтерии[ИмяРегистра].ПланСчетов;
        ИмяПланаСчетов = ПланСчетов.Имя;
        Счёт = ПланыСчетов[ИмяПланаСчетов].НайтиПоКоду(КодСчёта);
        Если Счёт.Пустая() Тогда
                ВызватьИсключение "Счёт не найден по коду: " + КодСчёта;
        КонецЕсли;
        Запрос.УстановитьПараметр("Счёт", Счёт);
        
        Если ПериодС <> Неопределено И ПериодС <> "" Тогда
                Запрос.УстановитьПараметр("ПериодС", ПреобразоватьДату(ПериодС));
        КонецЕсли;
        Если ПериодПо <> Неопределено И ПериодПо <> "" Тогда
                Запрос.УстановитьПараметр("ПериодПо", ПреобразоватьДату(ПериодПо));
        КонецЕсли;
        
        Если ФильтрИзмерений <> Неопределено И ТипЗнч(ФильтрИзмерений) = Тип("Соответствие") Тогда
                Для Каждого КЗ Из ФильтрИзмерений Цикл
                        Запрос.УстановитьПараметр("Изм_" + КЗ.Ключ, КЗ.Значение);
                КонецЦикла;
        КонецЕсли;
        
        Результат = Запрос.Выполнить();
        Если Результат.Пустой() Тогда
                СообщениеПусто = Новый Соответствие;
                СообщениеПусто.Вставить("message", "Нет данных по заданным параметрам");
                Возврат ОбъектВJSON(СообщениеПусто);
        КонецЕсли;
        
        Строки = Новый Массив;
        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
                Стр = Новый Соответствие;
                Для Каждого Колонка Из Результат.Колонки Цикл
                        Стр.Вставить(Колонка.Имя, ЗначениеДляJSON(Выборка[Колонка.Имя]));
                КонецЦикла;
                Строки.Добавить(Стр);
        КонецЦикла;
        
        Ответ = Новый Соответствие;
        Ответ.Вставить("register", ИмяРегистра);
        Ответ.Вставить("account", КодСчёта);
        Ответ.Вставить("balance_type", ТипОстатков);
        Ответ.Вставить("rows", Строки);
        Ответ.Вставить("count", Строки.Количество());
        Возврат ОбъектВJSON(Ответ);
        
КонецФункции
 
 
// #43 — get_register_totals: Остатки/обороты регистров накопления
Функция Инструмент_GetRegisterTotals(Аргументы)
        
        ПолноеИмя = Аргументы["full_name"];
        Если ПолноеИмя = Неопределено ИЛИ ПолноеИмя = "" Тогда
                ВызватьИсключение "Параметр full_name обязателен";
        КонецЕсли;
        
        Части = РазобратьПолноеИмя(ПолноеИмя);
        Если НРег(Части.Тип) <> "регистрнакопления" Тогда
                ВызватьИсключение "Ожидается РегистрНакопления, получен: " + Части.Тип;
        КонецЕсли;
        
        МДРегистр = Метаданные.РегистрыНакопления.Найти(Части.Имя);
        Если МДРегистр = Неопределено Тогда
                ВызватьИсключение "Регистр накопления не найден: " + Части.Имя;
        КонецЕсли;
        
        ТипОстатков = Аргументы["balance_type"];
        Если ТипОстатков = Неопределено ИЛИ ТипОстатков = "" Тогда
                ТипОстатков = "balance";
        КонецЕсли;
        
        // Виртуальная таблица
        Если ТипОстатков = "turnovers" Тогда
                ИмяВТ = "Обороты";
        ИначеЕсли ТипОстатков = "balance_and_turnovers" Тогда
                ИмяВТ = "ОстаткиИОбороты";
        Иначе
                Если МДРегистр.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты Тогда
                        ИмяВТ = "Обороты";
                        ТипОстатков = "turnovers";
                Иначе
                        ИмяВТ = "Остатки";
                КонецЕсли;
        КонецЕсли;
        
        // Ресурсы
        Ресурсы = Аргументы["resources"];
        Если Ресурсы <> Неопределено И Ресурсы <> "" Тогда
                СписокПолей = Ресурсы;
        Иначе
                СписокПолей = "*";
        КонецЕсли;
        
        ТекстЗапроса = "ВЫБРАТЬ " + СписокПолей + " ИЗ РегистрНакопления." + Части.Имя + "." + ИмяВТ + "(";
        
        ПараметрыВТ = Новый Массив;
        ПериодС = Аргументы["period_from"];
        ПериодПо = Аргументы["period_to"];
        Если ПериодС <> Неопределено И ПериодС <> "" Тогда
                ПараметрыВТ.Добавить("&ПериодС");
        Иначе
                ПараметрыВТ.Добавить("");
        КонецЕсли;
        Если ПериодПо <> Неопределено И ПериодПо <> "" Тогда
                ПараметрыВТ.Добавить("&ПериодПо");
        Иначе
                ПараметрыВТ.Добавить("");
        КонецЕсли;
        
        // Условие по измерениям
        ФильтрИзмерений = Аргументы["dimensions"];
        Если ФильтрИзмерений <> Неопределено И ТипЗнч(ФильтрИзмерений) = Тип("Соответствие") Тогда
                Условия = Новый Массив;
                Для Каждого КЗ Из ФильтрИзмерений Цикл
                        Условия.Добавить(КЗ.Ключ + " = &Изм_" + КЗ.Ключ);
                КонецЦикла;
                ПараметрыВТ.Добавить(СтрСоединить(Условия, " И "));
        Иначе
                ПараметрыВТ.Добавить("");
        КонецЕсли;
        
        ТекстЗапроса = ТекстЗапроса + СтрСоединить(ПараметрыВТ, ", ") + ")";
        
        Запрос = Новый Запрос(ТекстЗапроса);
        Если ПериодС <> Неопределено И ПериодС <> "" Тогда
                Запрос.УстановитьПараметр("ПериодС", ПреобразоватьДату(ПериодС));
        КонецЕсли;
        Если ПериодПо <> Неопределено И ПериодПо <> "" Тогда
                Запрос.УстановитьПараметр("ПериодПо", ПреобразоватьДату(ПериодПо));
        КонецЕсли;
        Если ФильтрИзмерений <> Неопределено И ТипЗнч(ФильтрИзмерений) = Тип("Соответствие") Тогда
                Для Каждого КЗ Из ФильтрИзмерений Цикл
                        Запрос.УстановитьПараметр("Изм_" + КЗ.Ключ, КЗ.Значение);
                КонецЦикла;
        КонецЕсли;
        
        Результат = Запрос.Выполнить();
        Если Результат.Пустой() Тогда
                СообщениеПусто = Новый Соответствие;
                СообщениеПусто.Вставить("message", "Нет данных");
                Возврат ОбъектВJSON(СообщениеПусто);
        КонецЕсли;
        
        Строки = Новый Массив;
        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
                Стр = Новый Соответствие;
                Для Каждого Колонка Из Результат.Колонки Цикл
                        Стр.Вставить(Колонка.Имя, ЗначениеДляJSON(Выборка[Колонка.Имя]));
                КонецЦикла;
                Строки.Добавить(Стр);
        КонецЦикла;
        
        Ответ = Новый Соответствие;
        Ответ.Вставить("register", ПолноеИмя);
        Ответ.Вставить("balance_type", ТипОстатков);
        Ответ.Вставить("rows", Строки);
        Ответ.Вставить("count", Строки.Количество());
        Возврат ОбъектВJSON(Ответ);
        
КонецФункции
 
 
// #44 — get_accounting_entries: Проводки документа
Функция Инструмент_GetAccountingEntries(Аргументы)
        
        СтрСсылка = Аргументы["document_ref"];
        Если СтрСсылка = Неопределено ИЛИ СтрСсылка = "" Тогда
                ВызватьИсключение "Параметр document_ref обязателен";
        КонецЕсли;
        
        ИмяРегистра = Аргументы["register_name"];
        Если ИмяРегистра = Неопределено ИЛИ ИмяРегистра = "" Тогда
                ИмяРегистра = "Хозрасчетный";
        КонецЕсли;
        
        МДРегистр = Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра);
        Если МДРегистр = Неопределено Тогда
                ВызватьИсключение "Регистр бухгалтерии не найден: " + ИмяРегистра;
        КонецЕсли;
        
        // Ищем ссылку как GUID
        Ссылка = XMLЗначение(Тип("УникальныйИдентификатор"), СтрСсылка);
        
        // Поиск документа по GUID через все типы документов
        НайденнаяСсылка = Неопределено;
        Для Каждого МДДок Из Метаданные.Документы Цикл
                Попытка
                        НайденнаяСсылка = Документы[МДДок.Имя].ПолучитьСсылку(Ссылка);
                        Если НайденнаяСсылка.ПолучитьОбъект() <> Неопределено Тогда
                                Прервать;
                        КонецЕсли;
                        НайденнаяСсылка = Неопределено;
                Исключение
                        НайденнаяСсылка = Неопределено;
                КонецПопытки;
        КонецЦикла;
        
        Если НайденнаяСсылка = Неопределено Тогда
                ВызватьИсключение "Документ не найден по GUID: " + СтрСсылка;
        КонецЕсли;
        
        // Запрос проводок
        ТекстЗапроса = "ВЫБРАТЬ
        |        СчётДт.Код КАК СчётДт,
        |        СчётКт.Код КАК СчётКт,
        |        Сумма,
        |        Количество,
        |        Содержание,
        |        Период
        |ИЗ РегистрБухгалтерии." + ИмяРегистра + "
        |ГДЕ Регистратор = &Регистратор
        |УПОРЯДОЧИТЬ ПО НомерСтроки";
        
        Запрос = Новый Запрос(ТекстЗапроса);
        Запрос.УстановитьПараметр("Регистратор", НайденнаяСсылка);
        
        Результат = Запрос.Выполнить();
        
        Строки = Новый Массив;
        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
                Стр = Новый Соответствие;
                Стр.Вставить("debit_account", Выборка.СчётДт);
                Стр.Вставить("credit_account", Выборка.СчётКт);
                Стр.Вставить("amount", Выборка.Сумма);
                Стр.Вставить("quantity", Выборка.Количество);
                Стр.Вставить("description", Выборка.Содержание);
                Стр.Вставить("period", ЗначениеДляJSON(Выборка.Период));
                Строки.Добавить(Стр);
        КонецЦикла;
        
        Ответ = Новый Соответствие;
        Ответ.Вставить("document", СтрСсылка);
        Ответ.Вставить("register", ИмяРегистра);
        Ответ.Вставить("entries", Строки);
        Ответ.Вставить("count", Строки.Количество());
        Возврат ОбъектВJSON(Ответ);
        

Функция Инструмент_TopRegister(Аргументы)
 
        ПолноеИмя = Аргументы["full_name"];
        Ресурс = Аргументы["resource"];
        Группировка = Аргументы["group_by"];
 
        Режим = Аргументы["mode"];
        Если Режим = Неопределено Тогда Режим = "остатки"; КонецЕсли;
        Режим = НРег(Режим);
 
        Топ = Аргументы["top"];
        Если Топ = Неопределено Или Топ = 0 Тогда Топ = 10; КонецЕсли;
        Если Топ > 1000 Тогда Топ = 1000; КонецЕсли;
 
        Если Не ЗначениеЗаполнено(ПолноеИмя) Или Не ЗначениеЗаполнено(Ресурс) Или Не ЗначениеЗаполнено(Группировка) Тогда
                Возврат "Нужны параметры: full_name (регистр), resource (ресурс), group_by (измерение).";
        КонецЕсли;
        Если Метаданные.НайтиПоПолномуИмени(ПолноеИмя) = Неопределено Тогда
                Возврат "Регистр не найден: " + ПолноеИмя;
        КонецЕсли;
 
        Запрос = Новый Запрос;
 
        Если Режим = "обороты" Тогда
                ДатаНач = Неопределено;
                ДатаКон = Неопределено;
                Если ЗначениеЗаполнено(Аргументы["period_from"]) Тогда ДатаНач = ПреобразоватьДату(Аргументы["period_from"]); КонецЕсли;
                Если ЗначениеЗаполнено(Аргументы["period_to"]) Тогда ДатаКон = ПреобразоватьДату(Аргументы["period_to"]); КонецЕсли;
                Запрос.УстановитьПараметр("Нач", ДатаНач);
                Запрос.УстановитьПараметр("Кон", ДатаКон);
                Источник = ПолноеИмя + ".Обороты(&Нач, &Кон, , )";
                ПолеЗначения = Ресурс + "Оборот";
        Иначе
                НаДату = Неопределено;
                Если ЗначениеЗаполнено(Аргументы["period_to"]) Тогда НаДату = ПреобразоватьДату(Аргументы["period_to"]); КонецЕсли;
                Запрос.УстановитьПараметр("НаДату", НаДату);
                Источник = ПолноеИмя + ".Остатки(&НаДату, )";
                ПолеЗначения = Ресурс + "Остаток";
        КонецЕсли;
 
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Топ, "ЧГ=0")
                + " Т." + Группировка + " КАК Группировка,"
                + " СУММА(Т." + ПолеЗначения + ") КАК Значение"
                + " ИЗ " + Источник + " КАК Т"
                + " СГРУППИРОВАТЬ ПО Т." + Группировка
                + " УПОРЯДОЧИТЬ ПО Значение УБЫВ";
 
        Строки = Новый Массив;
        Выборка = Запрос.Выполнить().Выбрать();
        Поз = 0;
        Пока Выборка.Следующий() Цикл
                Поз = Поз + 1;
                Стр = Новый Соответствие;
                Стр.Вставить("rank", Поз);
                Стр.Вставить("group", Строка(Выборка.Группировка));
                Стр.Вставить("value", ЗначениеДляJSON(Выборка.Значение));
                Строки.Добавить(Стр);
        КонецЦикла;
 
        Результат = Новый Соответствие;
        Результат.Вставить("register", ПолноеИмя);
        Результат.Вставить("mode", Режим);
        Результат.Вставить("resource", Ресурс);
        Результат.Вставить("group_by", Группировка);
        Результат.Вставить("rows", Строки);
        Результат.Вставить("count", Строки.Количество());
        Возврат ОбъектВJSONКомпакт(Результат);
 
КонецФункции
 
Функция Инструмент_SearchMetadata(Аргументы)
        
        СтрокаПоиска = НРег(Аргументы["query"]);
        ФильтрТипа = Аргументы["type_filter"];
        
        Найденные = Новый Массив;
        
        // Массив коллекций метаданных для поиска
        Коллекции = Новый Соответствие;
        Если Не ЗначениеЗаполнено(ФильтрТипа) Или НРег(ФильтрТипа) = "справочник" Тогда
                Коллекции.Вставить("Справочник", Метаданные.Справочники);
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ФильтрТипа) Или НРег(ФильтрТипа) = "документ" Тогда
                Коллекции.Вставить("Документ", Метаданные.Документы);
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ФильтрТипа) Или НРег(ФильтрТипа) = "регистр" Тогда
                Коллекции.Вставить("РегистрСведений", Метаданные.РегистрыСведений);
                Коллекции.Вставить("РегистрНакопления", Метаданные.РегистрыНакопления);
                Коллекции.Вставить("РегистрБухгалтерии", Метаданные.РегистрыБухгалтерии);
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ФильтрТипа) Или НРег(ФильтрТипа) = "перечисление" Тогда
                Коллекции.Вставить("Перечисление", Метаданные.Перечисления);
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ФильтрТипа) Или НРег(ФильтрТипа) = "пвх" Тогда
                Коллекции.Вставить("ПланВидовХарактеристик", Метаданные.ПланыВидовХарактеристик);
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ФильтрТипа) Или НРег(ФильтрТипа) = "плансчетов" Тогда
                Коллекции.Вставить("ПланСчетов", Метаданные.ПланыСчетов);
        КонецЕсли;
        
        Для Каждого КЭ Из Коллекции Цикл
                Для Каждого МД Из КЭ.Значение Цикл
                        Если СтрНайти(НРег(МД.Имя), СтрокаПоиска) > 0
                                Или СтрНайти(НРег(МД.Синоним), СтрокаПоиска) > 0 Тогда
                                Эл = Новый Соответствие;
                                Эл.Вставить("full_name", КЭ.Ключ + "." + МД.Имя);
                                Эл.Вставить("name", МД.Имя);
                                Эл.Вставить("synonym", МД.Синоним);
                                Эл.Вставить("type", КЭ.Ключ);
                                Найденные.Добавить(Эл);
                        КонецЕсли;
                КонецЦикла;
        КонецЦикла;
        
        Если Найденные.Количество() = 0 Тогда
                Возврат "Ничего не найдено по запросу: " + Аргументы["query"];
        КонецЕсли;
        
        Возврат ОбъектВJSONКомпакт(Найденные);
        
КонецФункции
 

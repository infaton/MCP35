                                                     Исключение
                                                     КонецПопытки;
                                    КонецЦикла;
                  КонецЕсли;
                  Попытка
                                    ВызватьСМассивомАргументов(Об, Метод, Новый Массив, Ложь);
                  Исключение
                                    Возврат "Ошибка run_data_processor: " + ОписаниеОшибки();
                  КонецПопытки;
                  Рез = Новый Соответствие;
                  Рез.Вставить("success", Истина);
                  Рез.Вставить("processor", "Обработка." + Имя);

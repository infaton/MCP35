Функция Инструмент_SimulateFillOnBasis(Аргументы)
                  ЦелевойТип = Аргументы["target_type"];
                  ТипОснования = Аргументы["base_type"];
                  GUIDОснования = Аргументы["base_guid"];
                  ДопРеквизиты = Аргументы["attributes"];
 
                  ЧастиОснования = РазобратьПолноеИмя(ТипОснования);
                  Если ЧастиОснования = Неопределено Тогда
                                    Возврат "Некорректное имя основания: " + ТипОснования;
                  КонецЕсли;
                  МенеджерОснования = ПолучитьМенеджерОбъекта(ЧастиОснования.Тип, ЧастиОснования.Имя);
                  СсылкаОснования = МенеджерОснования.ПолучитьСсылку(Новый УникальныйИдентификатор(GUIDОснования));
                  Если СсылкаОснования.ПолучитьОбъект() = Неопределено Тогда
                                    Возврат "Объект-основание не найден";
                  КонецЕсли;
 
                  ЧастиЦели = РазобратьПолноеИмя(ЦелевойТип);
                  Если ЧастиЦели.Тип = "Документ" Тогда
                                    НовыйОбъект = Документы[ЧастиЦели.Имя].СоздатьДокумент();
                  ИначеЕсли ЧастиЦели.Тип = "Справочник" Тогда
                                    НовыйОбъект = Справочники[ЧастиЦели.Имя].СоздатьЭлемент();
                  Иначе
                                    Возврат "simulate_fill_on_basis: только Справочник/Документ";
                  КонецЕсли;
 
                  Попытка
                                    НовыйОбъект.Заполнить(СсылкаОснования);
                  Исключение
                                    Попытка
                                                     Дан = Новый Структура("Основание", СсылкаОснования);
                                                     НовыйОбъект.Заполнить(Дан);
                                    Исключение
                                                     Возврат "Ошибка simulate fill: " + ОписаниеОшибки();
                                    КонецПопытки;
                  КонецПопытки;
 
                  Если ТипЗнч(ДопРеквизиты) = Тип("Соответствие") Тогда
                                    ЗаполнитьРеквизитыОбъекта(НовыйОбъект, ДопРеквизиты, ЦелевойТип);
                  КонецЕсли;
 
                  Рез = Новый Соответствие;
                  Рез.Вставить("dry_run", Истина);
                  Рез.Вставить("target_type", ЦелевойТип);
                  Рез.Вставить("base_type", ТипОснования);
                  Рез.Вставить("base_guid", GUIDОснования);
                  Шапка = Новый Соответствие;
                  Для Каждого Рек Из НовыйОбъект.Метаданные().Реквизиты Цикл
                                    Попытка
                                                     Шапка.Вставить(Рек.Имя, Строка(НовыйОбъект[Рек.Имя]));
                                    Исключение
                                    КонецПопытки;
                  КонецЦикла;
                  Рез.Вставить("header_preview", Шапка);
                  ТЧ = Новый Соответствие;
                  Для Каждого МДТЧ Из НовыйОбъект.Метаданные().ТабличныеЧасти Цикл
                                    ТЧ.Вставить(МДТЧ.Имя, НовыйОбъект[МДТЧ.Имя].Количество());
                  КонецЦикла;
                  Рез.Вставить("tabular_row_counts", ТЧ);
                  Возврат ОбъектВJSONКомпакт(Рез);
КонецФункции
 

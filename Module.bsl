// Привести строковое значение к типу метаданных (первый тип из описания).
Функция ПривестиЗначениеКТипу_В44(ЗначениеСтрока, ОписаниеТипов)
 
                  Значение = Строка(ЗначениеСтрока);
 
                  Если ОписаниеТипов.СодержитТип(Тип("Булево")) Тогда
                                    Возврат ВРег(Значение) = "TRUE" Или ВРег(Значение) = "ИСТИНА" Или Значение = "1";
                  ИначеЕсли ОписаниеТипов.СодержитТип(Тип("Число")) Тогда
                                    Попытка
                                                     Возврат Число(Значение);
                                    Исключение
                                                     Возврат Неопределено;
                                    КонецПопытки;
                  ИначеЕсли ОписаниеТипов.СодержитТип(Тип("Дата")) Тогда
                                    Попытка
                                                     Возврат Дата(СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, "-", ""), ":", ""), "T", ""));
                                    Исключение
                                                     Возврат Неопределено;
                                    КонецПопытки;
                  ИначеЕсли ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
                                    Возврат Значение;
                  КонецЕсли;
 
                  // Ссылочный тип: поиск по наименованию в первом ссылочном типе
                  Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
                                    МД = Метаданные.НайтиПоТипу(Тип);
                                    Если МД <> Неопределено И Метаданные.Справочники.Содержит(МД) Тогда
                                                     Ссылка = Справочники[МД.Имя].НайтиПоНаименованию(Значение, Истина);
                                                     Если ЗначениеЗаполнено(Ссылка) Тогда
                                                                       Возврат Ссылка;
                                                     КонецЕсли;
                                    КонецЕсли;
                  КонецЦикла;
 
                  Возврат Неопределено;
 
КонецФункции
 
// ============================================================================
// B2 (v4.4): перегруппировка отчёта run_report под запрошенный разрез
// ============================================================================
 
// B3 (v4.4.2) / B5 (v4.4.7): язык выражений СКД не знает функций и методов
// платформы (ТекущаяДатаСеанса(), Константы.X.Получить() и т.п.), поэтому типовые
// отчёты ЕРП с такими выражениями параметров при прямой компоновке вне формы
// падали с синтаксической ошибкой. В форме отчёта это разруливает БСП; здесь
// делаем обобщённо: для каждого параметра с непустым выражением пробуем вычислить
// его штатным Вычислить() и, если получилось, — очищаем выражение и подставляем
// готовое значение. Производные выражения СКД (&Период.ДатаНачала) и функции
// модуля отчёта (СделкиСервер.X) в этот контекст не входят — Вычислить на них
// мягко падает, выражение остаётся как есть (не хуже прежнего поведения).
Процедура НормализоватьВыраженияПараметровСхемы(Схема)
                  Попытка
                                    Для Каждого Парам Из Схема.Параметры Цикл
                                                     Выр = СокрЛП(Парам.Выражение);
                                                     Если ПустаяСтрока(Выр) Тогда
                                                                       Продолжить;
                                                     КонецЕсли;
                                                     // Ссылки на другие параметры (&Период.ДатаНачала и т.п.) разрешает сама СКД — не трогаем.
                                                     Если Лев(Выр, 1) = "&" Тогда
                                                                       Продолжить;
                                                     КонецЕсли;
                                                     Попытка
                                                                       ВычисленноеЗначение = Вычислить(Выр);
                                                                       Парам.Выражение = "";
                                                                       Парам.Значение = ВычисленноеЗначение;
                                                     Исключение
                                                                       // выражение неисполнимо в этом контексте (функции чужих модулей) — оставляем как есть
                                                     КонецПопытки;
                                    КонецЦикла;
                  Исключение
                  КонецПопытки;
КонецПроцедуры
 
// B4 (v4.4.3): применить границы периода ко всем параметрам типа СтандартныйПериод.
// В СКД-отчётах ЕРП период — один параметр СтандартныйПериод, а НачалоПериода и
// КонецПериода — производные выражения (&Период.ДатаНачала), напрямую не задаются.
Процедура ПрименитьПериодКПараметрам(Настройки, ДатаНач, ДатаКон)
                  Попытка
                                    Для Каждого ЗначениеП Из Настройки.ПараметрыДанных.Элементы Цикл
                                                     Если ТипЗнч(ЗначениеП.Значение) <> Тип("СтандартныйПериод") Тогда
                                                                       Продолжить;
                                                     КонецЕсли;
                                                     Период = Новый СтандартныйПериод;
                                                     Если ЗначениеЗаполнено(ДатаНач) Тогда
                                                                       Период.ДатаНачала = НачалоДня(ДатаНач);
                                                     КонецЕсли;
                                                     Если ЗначениеЗаполнено(ДатаКон) Тогда
                                                                       Период.ДатаОкончания = КонецДня(ДатаКон);
                                                     КонецЕсли;
                                                     ЗначениеП.Использование = Истина;
                                                     ЗначениеП.Значение = Период;
                                    КонецЦикла;
                  Исключение
                  КонецПопытки;
КонецПроцедуры
 
// B2: перегруппировка отчёта под запрошенный разрез (group_by). Только чтение.
Процедура ПрименитьРазрезКНастройкам(Настройки, Ресурсы, ПоляРазреза, Схема = Неопределено)
                  Настройки.Структура.Очистить();
                  Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
 
                  Для Каждого ИмяПоля Из ПоляРазреза Цикл
                                    ПолеГр = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
                                    ПолеГр.Поле = Новый ПолеКомпоновкиДанных(СокрЛП(Строка(ИмяПоля)));
                                    ПолеГр.Использование = Истина;
                  КонецЦикла;
 
                  Группировка.Выбор.Элементы.Очистить();
                  // Фикс B2.1: поле группировки тоже добавляем в выбор — иначе в строках
                  // не видно, ПО ЧЕМУ идёт разрез (пустые подписи групп).
                  Для Каждого ИмяПоля Из ПоляРазреза Цикл
                                    ВыбГр = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
                                    ВыбГр.Поле = Новый ПолеКомпоновкиДанных(СокрЛП(Строка(ИмяПоля)));
                                    ВыбГр.Использование = Истина;
                  КонецЦикла;
                  МассивРесурсов = Ресурсы;
                  Если ТипЗнч(МассивРесурсов) <> Тип("Массив") Или МассивРесурсов.Количество() = 0 Тогда
                                    МассивРесурсов = АвтоРесурсыСхемы(Настройки, Схема);
                  КонецЕсли;
                  Для Каждого ИмяРес Из МассивРесурсов Цикл
                                    ВыбПоле = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
                                    ВыбПоле.Поле = Новый ПолеКомпоновкиДанных(СокрЛП(Строка(ИмяРес)));
                                    ВыбПоле.Использование = Истина;
                  КонецЦикла;
КонецПроцедуры
 
// B2: авто-подбор ресурсов (числовых итогов) — best-effort.
// B2.2: сначала честные ПоляИтога схемы (пересечённые с полями наборов данных,
// т.к. вычисляемые итоги вида "ВНаличииВес" компоновщик в разрезе не примет),
// максимум 8 штук; фолбэк — старая эвристика по типичным именам.
Функция АвтоРесурсыСхемы(Настройки, Схема = Неопределено)
                  Рез = Новый Массив;
 
                  // 1) Поля итога схемы, реально существующие в наборах данных
                  Если Схема <> Неопределено Тогда
                                    Попытка
                                                     ПутиПолей = Новый Соответствие;
                                                     Для Каждого Набор Из Схема.НаборыДанных Цикл
                                                                       Если ТипЗнч(Набор) = Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных") Тогда
                                                                                         Для Каждого Вложенный Из Набор.Элементы Цикл
                                                                                                          Для Каждого Поле Из Вложенный.Поля Цикл
                                                                                                                            Если ТипЗнч(Поле) = Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") Тогда
                                                                                                                                              ПутиПолей.Вставить(Поле.ПутьКДанным, Истина);
                                                                                                                            КонецЕсли;
                                                                                                          КонецЦикла;
                                                                                         КонецЦикла;
                                                                       Иначе
                                                                                         Для Каждого Поле Из Набор.Поля Цикл
                                                                                                          Если ТипЗнч(Поле) = Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") Тогда
                                                                                                                            ПутиПолей.Вставить(Поле.ПутьКДанным, Истина);
                                                                                                          КонецЕсли;
                                                                                         КонецЦикла;
                                                                       КонецЕсли;
                                                     КонецЦикла;
                                                     Для Каждого ПолеИтога Из Схема.ПоляИтога Цикл
                                                                       Если Рез.Количество() >= 8 Тогда Прервать; КонецЕсли;
                                                                       Если ПутиПолей.Получить(ПолеИтога.ПутьКДанным) = Истина Тогда
                                                                                         Рез.Добавить(ПолеИтога.ПутьКДанным);
                                                                       КонецЕсли;
                                                     КонецЦикла;
                                    Исключение
                                                     Рез = Новый Массив;
                                    КонецПопытки;
                  КонецЕсли;
                  Если Рез.Количество() > 0 Тогда
                                    Возврат Рез;
                  КонецЕсли;
 
                  // 2) Фолбэк: типичные имена числовых итогов среди доступных полей выбора
                  Попытка
                                    Для Каждого ДоступноеПоле Из Настройки.Выбор.ДоступныеПоляВыбора.Элементы Цикл
                                                     Если Рез.Количество() >= 8 Тогда Прервать; КонецЕсли;
                                                     ИмяП = Строка(ДоступноеПоле.Поле);
                                                     Если СтрНайти(ИмяП, "Остаток") > 0 Или СтрНайти(ИмяП, "Оборот") > 0
                                                                       Или СтрНайти(ИмяП, "Сумма") > 0 Или СтрНайти(ИмяП, "Количество") > 0
                                                                       Или СтрНайти(ИмяП, "ВНаличии") > 0 Или СтрНайти(ИмяП, "Доступно") > 0 Тогда
                                                                       Рез.Добавить(ИмяП);
                                                     КонецЕсли;
                                    КонецЦикла;
                  Исключение
                  КонецПопытки;
                  Возврат Рез;
КонецФункции
 
 
